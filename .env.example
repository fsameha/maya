# Not needed to run the site: `pnpm dev` replays the recorded run with no keys.

# Meta Model API key (dev.meta.ai). Used only by the build-time scripts:
# pnpm killtest · pnpm record · pnpm eval · node scripts/build-run.mjs
MODEL_API_KEY=

# ElevenLabs key. Build time only, for `pnpm voice:render` (the pre-rendered demo voice). Never shipped.
ELEVENLABS_API_KEY=
