{
  "name": "maya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "predev": "node scripts/sync-fixtures.mjs",
    "prebuild": "node scripts/sync-fixtures.mjs",
    "fixtures:placeholder": "node scripts/make-placeholders.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "theme:build": "astryx theme build lib/theme/maya-theme.ts --out lib/theme/maya.css",
    "voice:render": "node scripts/voice-render.mjs",
    "record": "node scripts/record.mjs",
    "killtest": "node scripts/killtest.mjs",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.6",
    "@astryxdesign/theme-neutral": "^0.7.6",
    "@gsap/react": "^2.1.2",
    "@stylexjs/stylex": "^0.19.1",
    "flubber": "^0.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.6",
    "@meta-sam/parser": "^0.1.0",
